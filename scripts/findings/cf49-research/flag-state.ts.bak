import { createClient } from "@supabase/supabase-js";
import { config } from "dotenv";
config({ path: ".env.local" });

const supabase = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!);

async function main() {
  const keys = ["cf40_v4_algorithm", "document_dedup", "admin_attestation_enabled", "pdfjs_primary_v1", "ocr_reflow_v1", "classifier_haiku_regex_fallback_v1", "doc_type_override_v1", "bill_parser_sbc_marker_scan", "bill_parser_nan_guard", "bill_parser_arithmetic_check", "async_ingestion_ux_v1"];
  const { data, error } = await supabase.from("feature_flag_rules").select("flag_key, enabled, target_type, target_value, config").in("flag_key", keys);
  if (error) { console.log("Err:", error); return; }
  console.log("Modern flag state in PROD (feature_flag_rules):");
  for (const k of keys) {
    const rows = (data ?? []).filter(r => r.flag_key === k);
    if (rows.length === 0) { console.log(`  ${k}: <NOT FOUND>`); continue; }
    for (const r of rows) console.log(`  ${k}: enabled=${r.enabled}, target_type=${r.target_type}, target_value=${r.target_value ?? "n/a"}, config=${JSON.stringify(r.config)}`);
  }
}
main();
